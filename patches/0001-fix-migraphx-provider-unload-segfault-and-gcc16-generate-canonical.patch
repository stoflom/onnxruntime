From 5adc80e6897459d708a91c050afde195a3dddc30 Mon Sep 17 00:00:00 2001
From: Christoffel Lombard <stoflom@gmail.com>
Date: Wed, 28 Oct 2026 17:44:31 +0200
Subject: [PATCH 1/2] [ROCM] Do not unload the MIGraphX shared provider on
 Linux

Unloading libonnxruntime_providers_migraphx.so at ~OrtEnv runs the fini
routines of the whole ROCm dependency tree (libmigraphx, libamdhip64,
libhsa-runtime64, MIOpen, ...). Exit handlers and object teardown that
run afterwards then jump into unmapped memory and segfault the process
(ctest reported onnxruntime_provider_test as SEGFAULT after all gtests
had completed).

Mark s_library_migraphx with unload = false on non-Windows, matching
the existing treatment of the CUDA, CANN, TensorRT and VitisAI shared
providers, which are likewise never unloaded on Linux because doing so
crashes.
---
 onnxruntime/core/session/provider_bridge_ort.cc | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/onnxruntime/core/session/provider_bridge_ort.cc b/onnxruntime/core/session/provider_bridge_ort.cc
index 3a9a6f4c7e..5a53b6296f 100644
--- a/onnxruntime/core/session/provider_bridge_ort.cc
+++ b/onnxruntime/core/session/provider_bridge_ort.cc
@@ -2124,7 +2124,21 @@ static ProviderLibrary s_library_tensorrt(LIBRARY_PREFIX ORT_TSTR("onnxruntime_p
                                           false
 #endif
 );
-static ProviderLibrary s_library_migraphx(LIBRARY_PREFIX ORT_TSTR("onnxruntime_providers_migraphx") LIBRARY_EXTENSION);
+static ProviderLibrary s_library_migraphx(LIBRARY_PREFIX ORT_TSTR("onnxruntime_providers_migraphx") LIBRARY_EXTENSION
+#ifndef _WIN32
+                                          ,
+                                          /*
+                                           * unload - On Linux if we unload the migraphx shared provider we crash.
+                                           *
+                                           * Unloading runs the fini routines of the whole ROCm dependency tree
+                                           * (libmigraphx, libamdhip64, libhsa-runtime64, MIOpen, ...) during
+                                           * ~OrtEnv. Any exit handler or object teardown that afterwards touches
+                                           * code or vtables in the unloaded libraries then jumps into unmapped
+                                           * memory and segfaults the process.
+                                           */
+                                          false
+#endif
+);
 
 // QNN EP can be built either as a static library or a shared library. Can safely define s_library_qnn even if static.
 static ProviderLibrary s_library_qnn(LIBRARY_PREFIX ORT_TSTR("onnxruntime_providers_qnn") LIBRARY_EXTENSION);
-- 
