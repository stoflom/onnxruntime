From a9d3e029b126d697f363c5d44ad7a04b1368bcf5 Mon Sep 17 00:00:00 2001
From: Christoffel Lombard <stoflom@gmail.com>
Date: Wed, 28 Oct 2026 18:12:00 +0200
Subject: [PATCH 2/2] [cmake] Pin libstdc++ generate_canonical to the pre-GCC
 16 algorithm

GCC 16's libstdc++ implements P0952R2/LWG 2524 with a rewritten
std::generate_canonical that returns different values than every
earlier libstdc++. Random-op kernels (Multinomial, Sampling,
RandomNormal/Uniform) inline std::uniform_real_distribution over it,
so random op outputs and the recorded unit test expectations silently
changed with the toolchain, failing Random.MultinomialGoodCase,
Random.MultinomialDefaultDType and SamplingTest.Gpt2Sampling_CPU on
GCC 16 builds.

Define _GLIBCXX_USE_OLD_GENERATE_CANONICAL (libstdc++'s documented
compatibility macro) for non-MSVC builds to keep random op results
stable across toolchains. The macro is inert with libstdc++ older
than 16, with libc++ and with the MSVC STL.
---
 cmake/CMakeLists.txt | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
index 387b0fef74..2e80004966 100644
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -48,6 +48,17 @@ if (MSVC)
   set(CMAKE_PCH_PROLOGUE "")
 endif()
 
+if (NOT MSVC)
+  # libstdc++ 16 (GCC 16) implements P0952R2/LWG 2524 with a rewritten std::generate_canonical
+  # that produces different values than every earlier libstdc++. Random-op kernels (Multinomial,
+  # Sampling, RandomNormal/Uniform) inline std::uniform_real_distribution over it, so the outputs
+  # of random ops and the recorded unit test expectations would silently change with the
+  # toolchain. Opt into the old algorithm via libstdc++'s documented compatibility macro to keep
+  # random-op results stable across toolchains. The macro is inert with libstdc++ older than 16,
+  # with libc++ and with the MSVC STL.
+  add_compile_definitions(_GLIBCXX_USE_OLD_GENERATE_CANONICAL)
+endif()
+
 set_property(GLOBAL PROPERTY USE_FOLDERS ON)
 # NOTE: POSITION INDEPENDENT CODE hurts performance, and it only make sense on POSIX systems
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-- 
2.55.0

